// ============================================
// FONCTION PRINCIPALE POUR L'INSCRIPTION
// ============================================
function soumettreInscription(event) {
    // EMPÊCHER LE COMPORTEMENT PAR DÉFAUT DU FORMULAIRE
    event.preventDefault();
    
    console.log("✅ Fonction soumettreInscription appelée !");
    
    // Récupérer les valeurs du formulaire
    const nom = document.getElementById('nom').value;
    const email = document.getElementById('email').value;
    const tel = document.getElementById('tel').value;
    const niveau = document.getElementById('niveau').value;
    const cours = document.getElementById('cours').value;
    const message = document.getElementById('message').value;
    
    console.log("Données récupérées:", { nom, email, tel, niveau, cours, message });
    
    // Validation simple
    if (!nom || !email || !tel) {
        afficherResultat("Erreur", "Veuillez remplir tous les champs obligatoires (*)", "error");
        return false;
    }
    
    // Simuler l'envoi des données
    console.log("Envoi des données au serveur...");
    
    // Créer un objet avec les données
    const donneesInscription = {
        nom: nom,
        email: email,
        telephone: tel,
        niveau: niveau,
        cours: cours,
        message: message,
        date: new Date().toLocaleString('fr-FR'),
        reference: "SURF-" + Date.now().toString().slice(-6)
    };
    
    // Afficher dans la console
    console.log("Données à envoyer:", donneesInscription);
    
    // Simuler un délai d'envoi
    setTimeout(function() {
        // Afficher le résultat SUCCÈS
        const htmlConfirmation = `
            <p><strong>Merci ${donneesInscription.nom} !</strong></p>
            <p>Votre inscription a été enregistrée avec succès.</p>
            <div style="background: white; padding: 10px; border-radius: 5px; margin: 10px 0;">
                <p><strong>Récapitulatif :</strong></p>
                <p>📧 Email : ${donneesInscription.email}</p>
                <p>📱 Téléphone : ${donneesInscription.telephone}</p>
                <p>🏄 Niveau : ${donneesInscription.niveau}</p>
                <p>📋 Cours : ${donneesInscription.cours}</p>
                <p>📅 Date : ${donneesInscription.date}</p>
                <p>🔖 Référence : ${donneesInscription.reference}</p>
            </div>
            <p><small><i class="fas fa-info-circle"></i> Nous vous contacterons dans les 24h.</small></p>
            <button onclick="recommencerInscription()" style="margin-top: 10px; padding: 8px 15px; background: #1a5f7a; color: white; border: none; border-radius: 5px; cursor: pointer;">
                <i class="fas fa-redo"></i> Nouvelle inscription
            </button>
        `;
        
        afficherResultat("Inscription réussie !", htmlConfirmation, "success");
        
        // Les données RESTENT dans le formulaire (pas de reset)
        // L'utilisateur peut les voir et les modifier si besoin
        
    }, 1000); // 1 seconde de délai pour simuler l'envoi
    
    return false; // Empêche la soumission réelle du formulaire
}

// ============================================
// FONCTION POUR AFFICHER LE RÉSULTAT
// ============================================
function afficherResultat(titre, contenu, type) {
    const resultatDiv = document.getElementById('resultatInscription');
    const titreSpan = document.getElementById('titreConfirmation');
    const detailsDiv = document.getElementById('detailsConfirmation');
    
    if (resultatDiv && titreSpan && detailsDiv) {
        titreSpan.textContent = titre;
        detailsDiv.innerHTML = contenu;
        
        // Changer la couleur selon le type
        if (type === "error") {
            resultatDiv.style.backgroundColor = "#ffe6e6";
            resultatDiv.style.borderLeftColor = "#ff6b6b";
            titreSpan.style.color = "#ff6b6b";
        } else {
            resultatDiv.style.backgroundColor = "#e0f7fa";
            resultatDiv.style.borderLeftColor = "#57c5b6";
            titreSpan.style.color = "#159895";
        }
        
        // Afficher le div
        resultatDiv.style.display = 'block';
        
        // Faire défiler jusqu'au résultat
        resultatDiv.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
}

// ============================================
// FONCTION POUR RECOMMENCER UNE INSCRIPTION
// ============================================
function recommencerInscription() {
    const form = document.getElementById('formInscription');
    const resultatDiv = document.getElementById('resultatInscription');
    
    if (form) {
        // Réinitialiser le formulaire
        form.reset();
        
        // Cacher le résultat
        if (resultatDiv) {
            resultatDiv.style.display = 'none';
        }
        
        // Remettre le focus sur le premier champ
        document.getElementById('nom').focus();
        
        console.log("Formulaire réinitialisé pour nouvelle inscription");
    }
}

// ============================================
// GESTION DES TARIFS (simple)
// ============================================
function choisirTarif(tarif) {
    alert("Vous avez choisi : " + tarif + "\n\nVous allez être redirigé vers le formulaire d'inscription.");
    
    // Faire défiler jusqu'à l'inscription
    document.getElementById('inscription').scrollIntoView({ behavior: 'smooth' });
    
    // Pré-sélectionner le cours correspondant
    const selectCours = document.getElementById('cours');
    if (selectCours) {
        if (tarif.includes("Débutant")) {
            selectCours.value = "debutant";
        } else if (tarif.includes("Pack")) {
            selectCours.value = "pack5";
        } else if (tarif.includes("Privé")) {
            selectCours.value = "prive";
        } else if (tarif.includes("Stage")) {
            selectCours.value = "stage";
        }
    }
}

// ============================================
// GALERIE PHOTOS
// ============================================
let indexPhoto = 0;
const photos = document.querySelectorAll('.photo img');

function initGalerie() {
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    
    if (prevBtn && nextBtn && photos.length > 0) {
        prevBtn.addEventListener('click', function() {
            indexPhoto = (indexPhoto - 1 + photos.length) % photos.length;
            mettreAJourGalerie();
        });
        
        nextBtn.addEventListener('click', function() {
            indexPhoto = (indexPhoto + 1) % photos.length;
            mettreAJourGalerie();
        });
        
        mettreAJourGalerie();
    }
}

function mettreAJourGalerie() {
    photos.forEach((photo, index) => {
        if (index === indexPhoto) {
            photo.style.opacity = "1";
            photo.style.transform = "scale(1.05)";
        } else {
            photo.style.opacity = "0.7";
            photo.style.transform = "scale(1)";
        }
    });
}

// ============================================
// CALENDRIER POUR RDV
// ============================================
function initCalendrier() {
    const calendarDiv = document.getElementById('calendar');
    if (!calendarDiv) return;
    
    const aujourdHui = new Date();
    const annee = aujourdHui.getFullYear();
    const mois = aujourdHui.getMonth();
    
    genererCalendrier(annee, mois);
    
    // Mettre la date d'aujourd'hui par défaut
    const dateInput = document.getElementById('rdv-date');
    if (dateInput) {
        const yy = aujourdHui.getFullYear();
        const mm = String(aujourdHui.getMonth() + 1).padStart(2, '0');
        const dd = String(aujourdHui.getDate()).padStart(2, '0');
        dateInput.value = `${yy}-${mm}-${dd}`;
    }
}

function genererCalendrier(annee, mois) {
    const calendarDiv = document.getElementById('calendar');
    if (!calendarDiv) return;
    
    calendarDiv.innerHTML = '';
    
    // En-têtes des jours
    const jours = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
    jours.forEach(jour => {
        const entete = document.createElement('div');
        entete.className = 'day-header';
        entete.textContent = jour;
        calendarDiv.appendChild(entete);
    });
    
    // Premier jour du mois
    const premierJour = new Date(annee, mois, 1);
    // Dernier jour du mois
    const dernierJour = new Date(annee, mois + 1, 0);
    const aujourdHui = new Date();
    
    // Jours vides avant
    for (let i = 0; i < premierJour.getDay(); i++) {
        const vide = document.createElement('div');
        vide.className = 'day empty';
        calendarDiv.appendChild(vide);
    }
    
    // Jours du mois
    for (let jour = 1; jour <= dernierJour.getDate(); jour++) {
        const elementJour = document.createElement('div');
        elementJour.className = 'day';
        elementJour.textContent = jour;
        
        const dateCourante = new Date(annee, mois, jour);
        
        // Désactiver jours passés
        if (dateCourante < aujourdHui && dateCourante.getDate() !== aujourdHui.getDate()) {
            elementJour.classList.add('disabled');
        } else {
            elementJour.addEventListener('click', function() {
                // Mettre à jour le champ date
                const dateInput = document.getElementById('rdv-date');
                if (dateInput) {
                    const yy = dateCourante.getFullYear();
                    const mm = String(dateCourante.getMonth() + 1).padStart(2, '0');
                    const dd = String(dateCourante.getDate()).padStart(2, '0');
                    dateInput.value = `${yy}-${mm}-${dd}`;
                }
                
                // Mettre en surbrillance
                document.querySelectorAll('.day.selected').forEach(el => {
                    el.classList.remove('selected');
                });
                this.classList.add('selected');
            });
        }
        
        calendarDiv.appendChild(elementJour);
    }
}

// ============================================
// FORMULAIRE RDV
// ============================================
function initFormulaireRDV() {
    const formRdv = document.getElementById('formRdv');
    if (!formRdv) return;
    
    formRdv.addEventListener('submit', function(e) {
        e.preventDefault();
        
        const date = document.getElementById('rdv-date').value;
        const horaire = document.getElementById('rdv-horaire').value;
        const personnes = document.getElementById('rdv-personnes').value;
        const nom = document.getElementById('rdv-nom') ? document.getElementById('rdv-nom').value : '';
        const tel = document.getElementById('rdv-tel') ? document.getElementById('rdv-tel').value : '';
        
        if (!date || !horaire) {
            alert("Veuillez sélectionner une date et un horaire");
            return;
        }
        
        // Afficher confirmation
        const confirmationDiv = document.getElementById('rdvConfirmation');
        if (confirmationDiv) {
            const dateObj = new Date(date);
            const dateFormatee = dateObj.toLocaleDateString('fr-FR', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
            
            confirmationDiv.innerHTML = `
                <h4 style="color: #159895; margin-bottom: 10px;">
                    <i class="fas fa-check-circle"></i> Rendez-vous confirmé !
                </h4>
                <div style="background: white; padding: 10px; border-radius: 5px; margin: 10px 0;">
                    <p><strong>📅 Date :</strong> ${dateFormatee}</p>
                    <p><strong>🕐 Horaire :</strong> ${horaire}</p>
                    <p><strong>👥 Personnes :</strong> ${personnes}</p>
                    ${nom ? `<p><strong>👤 Nom :</strong> ${nom}</p>` : ''}
                    ${tel ? `<p><strong>📱 Téléphone :</strong> ${tel}</p>` : ''}
                    <p><strong>🔖 Référence :</strong> RDV-${Date.now().toString().slice(-6)}</p>
                </div>
                <button onclick="this.parentElement.style.display='none'" style="padding: 8px 15px; background: #1a5f7a; color: white; border: none; border-radius: 5px; cursor: pointer;">
                    Fermer
                </button>
            `;
            confirmationDiv.style.display = 'block';
        }
    });
}

// ============================================
// NAVIGATION MOBILE
// ============================================
function initNavigationMobile() {
    const burger = document.querySelector('.burger');
    const nav = document.querySelector('.nav-links');
    
    if (burger && nav) {
        burger.addEventListener('click', function() {
            nav.classList.toggle('active');
            burger.classList.toggle('toggle');
        });
        
        // Fermer le menu en cliquant sur un lien
        document.querySelectorAll('.nav-links a').forEach(lien => {
            lien.addEventListener('click', function() {
                nav.classList.remove('active');
                burger.classList.remove('toggle');
            });
        });
    }
}

// ============================================
// INITIALISATION AU CHARGEMENT
// ============================================
document.addEventListener('DOMContentLoaded', function() {
    console.log("✅ Site Maroc Surf Academy chargé avec succès");
    
    // Initialiser tous les composants
    initNavigationMobile();
    initGalerie();
    initCalendrier();
    initFormulaireRDV();
    
    // Mettre le focus sur le premier champ
    const nomInput = document.getElementById('nom');
    if (nomInput) {
        nomInput.focus();
    }
});
